{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "replay-config.schema.json",
  "title": "ReplayConfig — cấu hình replay/demo (FR-006, FR-016, FR-017)",
  "type": "object",
  "additionalProperties": false,
  "required": ["playback", "demo", "hud", "target_marker"],
  "properties": {
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speed", "loop", "display_hz", "hold_after_end_s"],
      "properties": {
        "speed": {"type": "number", "exclusiveMinimum": 0, "description": "Hệ số tốc độ; 1,0 = thời gian thực"},
        "loop": {"type": "boolean"},
        "display_hz": {"type": "integer", "minimum": 1, "maximum": 240},
        "hold_after_end_s": {"type": ["number", "null"], "minimum": 0, "description": "Giữ khung cuối bao lâu; null = tới khi người dùng đóng cửa sổ"}
      }
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split", "target_index", "seed"],
      "properties": {
        "split": {"enum": ["train", "test"]},
        "target_index": {"type": "integer", "minimum": 0},
        "seed": {"type": "integer", "minimum": 0}
      }
    },
    "hud": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decimals", "bar_width"],
      "properties": {
        "decimals": {"type": "integer", "minimum": 0, "maximum": 6},
        "bar_width": {"type": "integer", "minimum": 0, "maximum": 40}
      }
    },
    "target_marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radius_m", "rgba"],
      "properties": {
        "radius_m": {"type": "number", "exclusiveMinimum": 0},
        "rgba": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}
      }
    }
  }
}
