{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progress-snapshot.schema.json",
  "title": "ProgressSnapshot — API-TRN-0001 (GET /api/progress) và tệp progress.json (FR-020, FR-021, INV-005)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "stage", "seed", "status", "timestamp_utc", "update_idx", "env_steps", "total_steps", "env_steps_per_second", "mean_return", "loss", "activation", "checkpoint", "history"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string"},
    "stage": {"const": "elbow"},
    "seed": {"type": "integer", "minimum": 0},
    "status": {"enum": ["starting", "running", "done", "error", "interrupted"]},
    "timestamp_utc": {"type": "string", "format": "date-time", "description": "Lúc trainer ghi số liệu — mốc đo độ trễ NFR-PERF-002"},
    "update_idx": {"type": "integer", "minimum": 0},
    "env_steps": {"type": "integer", "minimum": 0},
    "total_steps": {"type": "integer", "minimum": 1},
    "env_steps_per_second": {"type": ["number", "null"], "minimum": 0},
    "mean_return": {"type": ["number", "null"], "description": "Reward trung bình mỗi episode của lượt cập nhật gần nhất; null khi chưa có episode nào"},
    "loss": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["policy", "value", "entropy"],
      "properties": {
        "policy": {"type": "number"},
        "value": {"type": "number"},
        "entropy": {"type": "number"}
      }
    },
    "activation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["muscle_names", "mean"],
      "properties": {
        "muscle_names": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string"}},
        "mean": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number", "minimum": 0, "maximum": 1}, "description": "Kích hoạt trung bình mỗi cơ trong lượt gần nhất"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "every_updates", "last_path", "last_update_idx"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "every_updates": {"type": "integer", "minimum": 1},
        "last_path": {"type": ["string", "null"]},
        "last_update_idx": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env_steps", "mean_return", "value_loss"],
      "properties": {
        "env_steps": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "mean_return": {"type": "array", "items": {"type": ["number", "null"]}},
        "value_loss": {"type": "array", "items": {"type": ["number", "null"]}}
      }
    }
  }
}
