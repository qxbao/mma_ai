{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "episode.schema.json",
  "title": "Episode — bản ghi một episode để phát lại 3D (FR-007, FR-009, INV-003, NFR-REL-001)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_utc", "seed", "model", "target", "source", "library_versions", "timing", "outcome", "frames"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "created_utc": {"type": "string", "format": "date-time"},
    "seed": {"type": "integer", "minimum": 0, "description": "Seed thực dùng ở reset của episode"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "source", "muscle_names", "nq", "nv"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Hash XML mô hình lúc ghi — đầu vào của phép kiểm lệch mô hình (INV-001)"},
        "source": {"type": "string", "pattern": "^[^/].*\\.xml$", "description": "Đường dẫn trong gói myo-sim; không bao giờ tuyệt đối"},
        "muscle_names": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Thứ tự = chỉ số trong activation và excitation"},
        "nq": {"type": "integer", "minimum": 1},
        "nv": {"type": "integer", "minimum": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_m", "split", "index", "tolerance_m"],
      "properties": {
        "position_m": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3},
        "split": {"type": ["string", "null"], "enum": ["train", "test", null], "description": "null khi mục tiêu không lấy từ tập của con 1"},
        "index": {"type": ["integer", "null"], "minimum": 0},
        "tolerance_m": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "source": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["checkpoint_path", "checkpoint_sha256", "run_id", "update_idx"],
      "description": "Hồ sơ checkpoint đã sinh ra episode; null khi episode không sinh từ checkpoint (tường minh, không bỏ trường)",
      "properties": {
        "checkpoint_path": {"type": "string", "pattern": "^[^/].*", "description": "Tương đối so với gốc dự án hoặc thư mục run"},
        "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_id": {"type": ["string", "null"]},
        "update_idx": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "library_versions": {"type": "object", "required": ["mujoco", "numpy"], "additionalProperties": {"type": "string"}},
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_dt_s", "physics_timestep_s"],
      "properties": {
        "action_dt_s": {"type": "number", "exclusiveMinimum": 0, "description": "Thời gian mô phỏng giữa hai khung liên tiếp (một hành động)"},
        "physics_timestep_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminated", "truncated", "end_reason", "reached", "n_actions", "final_distance_m"],
      "properties": {
        "terminated": {"type": "boolean"},
        "truncated": {"type": "boolean"},
        "end_reason": {"type": ["string", "null"], "enum": ["reached", "max_actions", "abnormal", null], "description": "null khi episode chưa kết thúc tự nhiên (tường minh)"},
        "reached": {"type": "boolean"},
        "n_actions": {"type": "integer", "minimum": 0, "description": "= số khung − 1"},
        "final_distance_m": {"type": ["number", "null"], "minimum": 0, "description": "null khi không có khoảng cách hợp lệ (episode bất thường)"}
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "description": "Khung 0 = trạng thái sau reset (excitation = null); khung k ≥ 1 = sau hành động thứ k",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t_s", "qpos", "qvel", "activation", "excitation", "fingertip_position_m", "distance_m", "reward"],
        "properties": {
          "t_s": {"type": "number", "minimum": 0},
          "qpos": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "qvel": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "activation": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number", "minimum": 0, "maximum": 1}},
          "excitation": {"type": ["array", "null"], "minItems": 6, "maxItems": 6, "items": {"type": "number", "minimum": 0, "maximum": 1}, "description": "Kích thích u đã áp bởi hành động dẫn tới khung này; null ở khung 0"},
          "fingertip_position_m": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3},
          "distance_m": {"type": "number", "minimum": 0},
          "reward": {"type": "number"}
        }
      }
    }
  }
}
